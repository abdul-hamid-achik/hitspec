# Authentication Flow Examples
# Demonstrates Bearer, Basic, API Key, and OAuth2 auth types
#
# Runs offline against the built-in mock server (>>>mock blocks give each
# request a canned httpbin-style response):
#   hitspec mock examples/auth-flow/auth.http     (terminal 1)
#   hitspec run examples/auth-flow/auth.http      (terminal 2)
# The mock does not check credentials -- it only replays the response -- so
# these tests prove the request/assertion plumbing, not the auth itself. To
# really exercise each scheme, set @baseUrl = https://httpbin.org (the
# requests below use httpbin's endpoints; if it answers 503 it is down, retry).

@baseUrl = http://localhost:3000
@token = my-secret-token-123
@username = testuser
@password = testpass
@apiKey = sk-test-key-abc123

### Bearer Token Authentication
# @name bearerAuth
# @description Authenticate with a Bearer token
# @tags auth, bearer
# @auth bearer {{token}}

GET {{baseUrl}}/bearer

>>>
expect status 200
expect body.authenticated == true
expect body.token == "my-secret-token-123"
<<<

>>>mock
{ "authenticated": true, "token": "my-secret-token-123" }
<<<

### Basic Authentication
# @name basicAuth
# @description Authenticate with username and password
# @tags auth, basic
# @auth basic {{username}}, {{password}}

GET {{baseUrl}}/basic-auth/testuser/testpass

>>>
expect status 200
expect body.authenticated == true
expect body.user == "testuser"
<<<

>>>mock
{ "authenticated": true, "user": "testuser" }
<<<

### API Key in Header
# @name apiKeyHeader
# @description Send API key via custom header
# @tags auth, apikey
# @auth apiKey X-API-Key, {{apiKey}}

GET {{baseUrl}}/headers

>>>
expect status 200
expect header Content-Type contains json
expect body.headers.X-Api-Key == "sk-test-key-abc123"
<<<

>>>mock
{ "headers": { "X-Api-Key": "sk-test-key-abc123", "Host": "localhost:3000" } }
<<<

### API Key in Query String
# @name apiKeyQuery
# @description Send API key as query parameter
# @tags auth, apikey
# @auth apiKeyQuery api_key, {{apiKey}}

GET {{baseUrl}}/get

>>>
expect status 200
expect body.args.api_key == "sk-test-key-abc123"
<<<

>>>mock
{ "args": { "api_key": "sk-test-key-abc123" }, "url": "http://localhost:3000/get" }
<<<

### Digest Authentication
# @name digestAuth
# @description Authenticate with HTTP Digest auth
# @tags auth, digest
# @auth digest user, passwd

GET {{baseUrl}}/digest-auth/auth/user/passwd

>>>
expect status 200
expect body.authenticated == true
expect body.user == "user"
<<<

>>>mock
{ "authenticated": true, "user": "user" }
<<<

### Chained Auth Flow: Login then Access Protected Resource
# @name login
# @description Simulate login to get a token
# @tags auth, flow

POST {{baseUrl}}/post
Content-Type: application/json

{
  "username": "admin",
  "password": "secret"
}

>>>
expect status 200
expect body.json.username == "admin"
<<<

>>>mock
{ "json": { "username": "admin", "password": "secret" }, "headers": { "Host": "localhost:3000" } }
<<<

>>>capture
sessionToken from body.headers.Host
<<<

### Access Protected Resource with Captured Token
# @name protectedResource
# @description Use token from login to access a protected endpoint
# @tags auth, flow
# @depends login

GET {{baseUrl}}/anything
Authorization: Bearer {{login.sessionToken}}

>>>
expect status 200
expect body.headers.Authorization startsWith "Bearer"
<<<

>>>mock
{ "headers": { "Authorization": "Bearer localhost:3000" } }
<<<
