{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "hitspec",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#88C0D0",
    "light": "#8FBCBB",
    "dark": "#5E81AC"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/abdul-hamid-achik/hitspec"
      },
      {
        "label": "Changelog",
        "href": "https://github.com/abdul-hamid-achik/hitspec/blob/main/CHANGELOG.md"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install",
      "href": "/installation"
    }
  },
  "navigation": {
    "global": {
      "tabs": [
        {
          "tab": "Documentation",
          "href": "/"
        },
        {
          "tab": "Examples",
          "href": "/examples"
        },
        {
          "tab": "Reference",
          "href": "/reference"
        }
      ],
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/abdul-hamid-achik/hitspec"
        }
      ]
    },
    "groups": [
      {
        "group": "Getting Started",
        "pages": [
          "introduction",
          "installation",
          "quickstart",
          "editor-setup"
        ]
      },
      {
        "group": "Core Concepts",
        "pages": [
          "concepts/file-format",
          "concepts/variables",
          "concepts/assertions",
          "concepts/captures",
          "concepts/dependencies",
          "concepts/environments"
        ]
      },
      {
        "group": "Features",
        "pages": [
          "features/authentication",
          "features/multipart-graphql",
          "features/snapshot-testing",
          "features/stress-testing",
          "features/database-assertions",
          "features/shell-commands",
          "features/hooks",
          "features/sse",
          "features/api-coverage",
          "features/mock-server"
        ]
      },
      {
        "group": "Examples",
        "pages": [
          "examples/basic-crud",
          "examples/auth-flow",
          "examples/graphql",
          "examples/ci-cd",
          "examples/stress-testing"
        ]
      },
      {
        "group": "CLI Reference",
        "pages": [
          "reference/run",
          "reference/validate-list",
          "reference/import-export",
          "reference/mock-record",
          "reference/contract-diff"
        ]
      },
      {
        "group": "Integrations",
        "pages": [
          "integrations/github-actions",
          "integrations/output-formats"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/abdul-hamid-achik/hitspec"
    }
  }
}
