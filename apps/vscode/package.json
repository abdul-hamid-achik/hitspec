{
  "name": "hitspec",
  "displayName": "hitspec",
  "description": "Syntax highlighting and snippets for hitspec HTTP API testing files",
  "version": "0.2.0",
  "publisher": "hitspec",
  "repository": {
    "type": "git",
    "url": "https://github.com/abdul-hamid-achik/hitspec"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "http",
    "api",
    "testing",
    "rest",
    "hitspec",
    "websocket",
    "graphql"
  ],
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "hitspec",
        "aliases": ["hitspec", "HTTP"],
        "extensions": [".http", ".hitspec"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hitspec",
        "scopeName": "source.hitspec",
        "path": "./syntaxes/hitspec.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "hitspec",
        "path": "./snippets/hitspec.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.22.0"
  }
}
