{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "hitspec",
  "scopeName": "source.hitspec",
  "patterns": [
    { "include": "#separators" },
    { "include": "#comments" },
    { "include": "#annotations" },
    { "include": "#variables" },
    { "include": "#methods" },
    { "include": "#file-include" },
    { "include": "#query-params" },
    { "include": "#headers" },
    { "include": "#typed-blocks" },
    { "include": "#assertions" },
    { "include": "#legacy-capture" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#interpolation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.hitspec",
          "match": "^//.*$"
        },
        {
          "name": "comment.line.number-sign.hitspec",
          "match": "^#(?!##)(?!\\s*@).*$"
        }
      ]
    },
    "separators": {
      "patterns": [
        {
          "name": "markup.heading.hitspec",
          "match": "^###.*$"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.tag.hitspec",
          "match": "^#\\s*@(name|description|tags|skip|only|timeout|retry|retryOn|retryDelay|depends|auth|before|after|db|wait[Ff]or|if|unless|import|stress\\.\\w+|contract\\.\\w+|x-[\\w.-]+)\\b",
          "captures": {
            "1": { "name": "keyword.other.annotation.hitspec" }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.hitspec",
          "match": "^@[a-zA-Z_][a-zA-Z0-9_]*\\s*=",
          "captures": {
            "0": { "name": "variable.other.assignment.hitspec" }
          }
        }
      ]
    },
    "methods": {
      "patterns": [
        {
          "name": "keyword.other.method.hitspec",
          "match": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|TRACE|CONNECT|WS)\\b"
        }
      ]
    },
    "headers": {
      "patterns": [
        {
          "name": "entity.name.tag.header.hitspec",
          "match": "^([A-Za-z][A-Za-z0-9-]*)(:)",
          "captures": {
            "1": { "name": "entity.name.tag.header-name.hitspec" },
            "2": { "name": "punctuation.separator.key-value.hitspec" }
          }
        }
      ]
    },
    "file-include": {
      "patterns": [
        {
          "name": "meta.file-include.hitspec",
          "match": "^(<)\\s+(\\S+)",
          "captures": {
            "1": { "name": "keyword.operator.include.hitspec" },
            "2": { "name": "string.unquoted.file-path.hitspec" }
          }
        }
      ]
    },
    "query-params": {
      "patterns": [
        {
          "name": "meta.query-param.hitspec",
          "match": "^\\s*([?&])\\s*(\\S+)\\s*(=)\\s*(.*)",
          "captures": {
            "1": { "name": "punctuation.definition.query.hitspec" },
            "2": { "name": "variable.parameter.query.hitspec" },
            "3": { "name": "keyword.operator.assignment.hitspec" },
            "4": {
              "patterns": [
                { "include": "#interpolation" },
                {
                  "name": "string.unquoted.query-value.hitspec",
                  "match": ".+"
                }
              ]
            }
          }
        }
      ]
    },
    "typed-blocks": {
      "patterns": [
        {
          "name": "meta.block.typed.hitspec",
          "begin": "^>>>(capture|graphql|db|shell|multipart|variables)",
          "end": "^<<<",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.block.begin.hitspec" },
            "1": { "name": "keyword.other.block-type.hitspec" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.end.hitspec" }
          },
          "patterns": [
            {
              "name": "keyword.control.expect.hitspec",
              "match": "\\bexpect\\b"
            },
            {
              "name": "keyword.control.from.hitspec",
              "match": "\\bfrom\\b"
            },
            {
              "name": "keyword.control.query.hitspec",
              "match": "\\b(query|field|file)\\b"
            },
            {
              "name": "keyword.operator.comparison.hitspec",
              "match": "==|!=|>=|<=|>|<"
            },
            {
              "name": "keyword.operator.comparison.hitspec",
              "match": "!(?:contains|exists|includes|in)\\b"
            },
            {
              "name": "keyword.operator.comparison.hitspec",
              "match": "\\b(contains|startsWith|endsWith|matches|exists|length|includes|in|type|each|schema|snapshot)\\b"
            },
            {
              "name": "variable.other.subject.hitspec",
              "match": "\\b(status|duration|body|headers?|p50|p95|p99)\\b"
            },
            {
              "name": "support.type.hitspec",
              "match": "\\b(string|number|boolean|array|object)\\b"
            },
            { "include": "#constants" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#interpolation" }
          ]
        }
      ]
    },
    "assertions": {
      "patterns": [
        {
          "name": "meta.assertion.hitspec",
          "begin": "^>>>$",
          "end": "^<<<",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.assertion.begin.hitspec" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.assertion.end.hitspec" }
          },
          "patterns": [
            {
              "name": "keyword.control.expect.hitspec",
              "match": "\\bexpect\\b"
            },
            {
              "name": "keyword.operator.comparison.hitspec",
              "match": "==|!=|>=|<=|>|<"
            },
            {
              "name": "keyword.operator.comparison.hitspec",
              "match": "!(?:contains|exists|includes|in)\\b"
            },
            {
              "name": "keyword.operator.comparison.hitspec",
              "match": "\\b(contains|startsWith|endsWith|matches|exists|length|includes|in|type|each|schema|snapshot)\\b"
            },
            {
              "name": "variable.other.subject.hitspec",
              "match": "\\b(status|duration|body|headers?|p50|p95|p99)\\b"
            },
            {
              "name": "support.type.hitspec",
              "match": "\\b(string|number|boolean|array|object)\\b"
            },
            { "include": "#constants" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#interpolation" }
          ]
        }
      ]
    },
    "legacy-capture": {
      "patterns": [
        {
          "name": "punctuation.definition.capture.begin.hitspec",
          "match": "^\\[\\[\\[$"
        },
        {
          "name": "punctuation.definition.capture.end.hitspec",
          "match": "^\\]\\]\\]$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.hitspec",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#interpolation" },
            {
              "name": "constant.character.escape.hitspec",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.hitspec",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#interpolation" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hitspec",
          "match": "-?\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.hitspec",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.hitspec",
          "match": "\\bnull\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.hitspec",
          "match": "\\$(?:uuid|timestamp|timestampMs|random|randomInt|randomString|randomEmail|randomAlphanumeric|env|file|base64|base64Decode|md5|sha256|now|date|urlEncode|urlDecode|json)\\b"
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.hitspec",
          "begin": "\\{\\{",
          "end": "\\}\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.interpolation.begin.hitspec" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.interpolation.end.hitspec" }
          },
          "patterns": [
            { "include": "#functions" },
            {
              "name": "variable.other.interpolation.hitspec",
              "match": "[a-zA-Z_][a-zA-Z0-9_\\.]*"
            }
          ]
        }
      ]
    }
  }
}
