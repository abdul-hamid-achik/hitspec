{
  "cli.contract": {
    "defaults": {
      "timeout": "30s",
      "followRedirects": true,
      "maxRedirects": 10,
      "validateSSL": true,
      "retries": 0,
      "retryDelay": "1s"
    },
    "yaml": {
      "timeout": "30s",
      "followRedirects": true,
      "maxRedirects": 10,
      "validateSSL": true,
      "retries": 0,
      "retryDelay": "1s"
    },
    "yaml+env": {
      "timeout": "30s",
      "followRedirects": true,
      "maxRedirects": 10,
      "validateSSL": true,
      "retries": 0,
      "retryDelay": "1s"
    },
    "yaml+env+flags": {
      "timeout": "30s",
      "followRedirects": true,
      "maxRedirects": 10,
      "validateSSL": true,
      "retries": 0,
      "retryDelay": "1s"
    }
  },
  "cli.run": {
    "defaults": {
      "environment": "dev",
      "timeout": "30s",
      "followRedirects": true,
      "maxRedirects": 10,
      "validateSSL": true,
      "retries": 0,
      "retryDelay": "1s",
      "parallel": false,
      "concurrency": 5,
      "bail": false
    },
    "yaml": {
      "environment": "staging",
      "timeout": "30s",
      "followRedirects": false,
      "maxRedirects": 10,
      "validateSSL": false,
      "proxy": "http://yaml-proxy.invalid:8080",
      "headers": {
        "Accept": "application/yaml",
        "X-From": "yaml"
      },
      "retries": 0,
      "retryDelay": "1s",
      "parallel": false,
      "concurrency": 5,
      "bail": false
    },
    "yaml+env": {
      "environment": "staging",
      "timeout": "7s",
      "followRedirects": false,
      "maxRedirects": 10,
      "validateSSL": false,
      "proxy": "http://env-proxy.invalid:8080",
      "headers": {
        "Accept": "application/yaml",
        "X-From": "yaml"
      },
      "retries": 0,
      "retryDelay": "1s",
      "parallel": false,
      "concurrency": 2,
      "bail": false
    },
    "yaml+env+flags": {
      "environment": "staging",
      "timeout": "9s",
      "followRedirects": false,
      "maxRedirects": 10,
      "validateSSL": false,
      "proxy": "http://flag-proxy.invalid:8080",
      "headers": {
        "Accept": "application/yaml",
        "X-From": "yaml"
      },
      "retries": 0,
      "retryDelay": "1s",
      "parallel": true,
      "concurrency": 3,
      "bail": true
    }
  },
  "cli.stress": {
    "defaults": {
      "timeout": "30s",
      "followRedirects": true,
      "maxRedirects": 10,
      "validateSSL": true,
      "retries": 0,
      "retryDelay": "1s"
    },
    "yaml": {
      "timeout": "30s",
      "followRedirects": false,
      "maxRedirects": 10,
      "validateSSL": false,
      "proxy": "http://yaml-proxy.invalid:8080",
      "retries": 0,
      "retryDelay": "1s"
    },
    "yaml+env": {
      "timeout": "30s",
      "followRedirects": false,
      "maxRedirects": 10,
      "validateSSL": false,
      "proxy": "http://env-proxy.invalid:8080",
      "retries": 0,
      "retryDelay": "1s"
    },
    "yaml+env+flags": {
      "timeout": "30s",
      "followRedirects": false,
      "maxRedirects": 10,
      "validateSSL": false,
      "proxy": "http://flag-proxy.invalid:8080",
      "retries": 0,
      "retryDelay": "1s"
    }
  }
}
