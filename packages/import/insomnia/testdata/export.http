# environments:
defaultEnvironment: base
environments:
    base:
        baseUrl: https://api.example.com
        debug: false
        nested: '{"a":1}'
        port: 1234567
        retries: 3
        token: base-token
    development:
        baseUrl: http://localhost:3000
        debug: false
        nested: '{"a":1}'
        port: 1234567
        retries: 3
        token: base-token
    production:
        baseUrl: https://api.example.com
        debug: false
        nested: '{"a":1}'
        port: 1234567
        retries: 3
        token: '{{prodToken}}'

# warnings:
# - environment variable "nested" in "Base Environment" is an object/array; stored as a JSON string
# - Upload: auth type "oauth2" is not supported and was dropped
# - Insomnia template tags ({% ... %}) have no hitspec equivalent and were left as is
