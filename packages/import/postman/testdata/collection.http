@version = 2
@orgId = 1234567

### Users - List users
# @name List_users
# TODO: untranslated test: pm.environment.set("firstId", jsonData.users[0].id)
# TODO: untranslated test: if (jsonData.flag)
# @auth bearer {{token}}
GET {{baseUrl}}/v{{version}}/users?limit=10
Accept: application/json

>>>
expect status == 200
expect body.users[0].name == "Ann"
expect body.total > 0
expect body.users type array
expect body.total exists
expect duration < 500
<<<

### Users - Create user
# @name Create_user
# @auth basic admin, {{pw}}
POST {{baseUrl}}/users
Content-Type: application/json

{"name": "{{$randomEmail()}}", "id": "{{$uuid()}}"}

### Users - Login form
# @name Login_form
POST {{baseUrl}}/login

user=a+b&tok={{token}}

### Users - Upload
# @name Upload
# @auth apiKey X-API-Key, {{apiKey}}
POST {{baseUrl}}/upload

>>>multipart
field title = Report
file doc @./report.pdf
<<<

